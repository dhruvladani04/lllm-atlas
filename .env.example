# Canonical site URL — used for canonical links, og:url, robots.txt and the sitemap.
# Optional on Vercel: with this unset the site falls back to VERCEL_PROJECT_PRODUCTION_URL
# (the stable production domain, so preview deploys do not advertise themselves as
# canonical), then to VERCEL_URL, then to localhost. Set it explicitly for a custom domain.
SITE_URL=http://localhost:3000

# mirror | link — see specs/01-architecture/stack-and-structure.md
BENCHWIKI_MODE=mirror

# Ingestion only. Never referenced from app/.
OPENROUTER_API_KEY=
